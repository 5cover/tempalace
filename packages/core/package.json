{
  "name": "@tempalace/core",
  "version": "0.1.1",
  "description": "Typed template primitives for Tempalace",
  "keywords": [
    "templates",
    "zod",
    "typescript",
    "cli"
  ],
  "license": "MIT",
  "author": "Scover",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5cover/tempalace.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/5cover/tempalace/issues"
  },
  "homepage": "https://github.com/5cover/tempalace#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^5.9.3"
  }
}
