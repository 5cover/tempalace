{
  "name": "tempalace",
  "version": "0.1.0",
  "description": "Interactive CLI for Tempalace templates",
  "keywords": [
    "templates",
    "cli",
    "zod",
    "typescript",
    "interactive"
  ],
  "license": "MIT",
  "author": "Scover",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5cover/tempalace.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/5cover/tempalace/issues"
  },
  "homepage": "https://github.com/5cover/tempalace#readme",
  "type": "module",
  "bin": {
    "tp": "./dist/main.js",
    "tempalace": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @tempalace/core build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @tempalace/core build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "prepack": "pnpm --filter @tempalace/core build && pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@inquirer/prompts": "^8.7.2",
    "@inquirer/search": "^4.3.3",
    "@tempalace/core": "workspace:*",
    "clipboardy": "^5.3.2",
    "commander": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^5.9.3"
  }
}
