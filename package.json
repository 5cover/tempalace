{
  "name": "tempalace-workspace",
  "private": true,
  "version": "0.1.1",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "pack:check": "pnpm --filter @tempalace/core pack --dry-run && pnpm --filter tempalace pack --dry-run",
    "publish:check": "pnpm typecheck && pnpm test && pnpm build && pnpm pack:check"
  },
  "devDependencies": {
    "@tempalace/core": "workspace:*",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "trailingComma": "es5",
    "semi": false
  }
}
